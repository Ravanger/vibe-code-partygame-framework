    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@partygame/config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
