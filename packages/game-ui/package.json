    "typecheck": "tsc -p tsconfig.test.json && svelte-check --tsconfig ./tsconfig.test.json --threshold warning"
  },
  "dependencies": {
    "@partygame/client-utils": "workspace:*",
    "@partygame/game-client": "workspace:*",
    "@partygame/shared": "workspace:*",
