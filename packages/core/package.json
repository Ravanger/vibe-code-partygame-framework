    },
    "./awards": {
      "types": "./dist/awards/index.d.ts",
      "import": "./dist/awards/index.js",
      "default": "./dist/awards/index.js"
    },
    "./kits": {
      "types": "./dist/kits/index.d.ts",
      "import": "./dist/kits/index.js",
      "default": "./dist/kits/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js",
      "default": "./dist/replay/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@partygame/content": "workspace:*",
    "@partygame/shared": "workspace:*",
    "zod": "^4.6.5",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@partygame/config": "workspace:*",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
