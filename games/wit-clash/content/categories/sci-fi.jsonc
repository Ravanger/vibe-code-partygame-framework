    { "id": "sf-22", "text": "The warning label on a shrink ray." },
    { "id": "sf-23", "text": "What your clone did while you were out." },
    { "id": "sf-24", "text": "A cheesy tagline for a movie about space truckers." },
    { "id": "sf-25", "text": "A job posting for an interstellar janitor." },
    { "id": "sf-26", "text": "The real reason the aliens finally visited Earth." },
    { "id": "sf-27", "text": "A perfectly ordinary problem faced by a Mars colony." },
    {
      "id": "sf-28",
