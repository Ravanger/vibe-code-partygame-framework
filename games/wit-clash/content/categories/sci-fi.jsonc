  "prompts": [
    { "id": "sf-1", "text": "The name of a brand-new planet, chosen by an online poll." },
    { "id": "sf-2", "text": "A useless invention from the year 3000 that everybody owns anyway." },
    { "id": "sf-3", "text": "The one time-travel rule printed on every time machine's dashboard." },
    { "id": "sf-4", "text": "An alien superpower that's mostly just inconvenient at parties." },
    { "id": "sf-5", "text": "The one very human weakness that ended the robot uprising." },
    { "id": "sf-6", "text": "The plot of a sci-fi epic where the big threat is a very slow leak." },
    { "id": "sf-7", "text": "The space law everybody breaks while parked near Jupiter." },
    { "id": "sf-8", "text": "The best thing to put after https:// in a fake alien URL." },
    {
      "id": "sf-9",
      "text": "The rejected name for the warp drive, after it was tested on the intern."
