    { "id": "sf-10", "text": "What the ship's computer says when you ask it to do the dishes." },
    {
      "id": "sf-11",
      "text": "The worst thing to hear over a spaceship intercom, said far too calmly."
    },
    { "id": "sf-12", "text": "The national pastime on a planet with no gravity on Tuesdays." },
    {
      "id": "sf-13",
      "text": "What you'd do with a time machine that only works for five minutes."
