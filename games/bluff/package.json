    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --hot server.ts",
