    "@partygame/game-client": "workspace:*",
    "@partygame/game-kit": "workspace:*",
    "@partygame/game-ui": "workspace:*",
    "@partygame/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@partygame/config": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
