{
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "plugins": [
    "./biome-plugins/prefer-prefix-increment.grit",
    "./biome-plugins/vi-mock-node-only.grit",
    "./biome-plugins/no-decorators.grit"
  ],
  "overrides": [
    {
      "includes": ["**", "!packages/server/**"],
      "plugins": ["./biome-plugins/no-session-id.grit"]
    },
    {
      "includes": ["**/*.test.ts"],
      "plugins": ["./biome-plugins/test-has-expect.grit"]
    }
  ]
}
