{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/api/schema/stryker-core.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.config.mts" },
  "mutate": [
    "packages/*/src/**/*.ts",
    "games/*/src/**/*.ts",
    "games/*/ui/**/*.ts",
    "games/*/bots/**/*.ts",
    "games/*/terminal/**/*.ts",
    "games/*/gamePackage.ts",
    "!games/*/ui/main.ts",
    "!games/*/bots/cli.ts",
    "!games/*/terminal/play.ts",
    "!games/*/terminal/demo.ts",
    "!**/*.d.ts",
    "!**/*.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "clearTextReporter": { "logTests": false },
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 90, "low": 85, "break": 80 },
  "inPlace": true,
  "concurrency": 4,
  "ignoreStatic": true
}
