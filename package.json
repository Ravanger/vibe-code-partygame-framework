{
  "name": "partygame",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev:all": "turbo run dev dev:server",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "dev": "turbo run dev dev:server",
    "games": "bun run scripts/game.ts list",
    "new": "bun packages/cli/src/cli.ts create",
    "bots": "bun run scripts/game.ts bots",
    "play": "bun run scripts/game.ts play",
    "launch": "bun run scripts/game.ts launch",
    "launch:dev": "bun run scripts/game.ts launch dev",
    "launch:host": "bun run scripts/game.ts launch host",
    "launch:prod": "bun run scripts/game.ts launch prod",
    "launch:bots": "bun run scripts/game.ts launch dev --bots",
    "launch:demo": "bun run scripts/game.ts launch dev --demo",
    "test:coverage": "vitest run --coverage",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:agents": "bun run scripts/checkAgentsFilesCli.ts",
    "check:boundaries": "bun run scripts/checkBoundariesCli.ts",
    "check:exports": "bun run scripts/checkExportsCli.ts",
    "verify": "biome check . && bun run check:agents && bun run check:boundaries && bun run check:exports && bun run typecheck:scripts && bun run typecheck && vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
