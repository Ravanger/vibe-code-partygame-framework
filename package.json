{
  "name": "partygame",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.0",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev:all": "turbo run dev dev:server",
    "build": "turbo build",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "dev": "turbo run dev dev:server",
    "bots": "bun run games/wit-clash/bots/cli.ts",
    "cli:play": "bun run games/wit-clash/terminal/play.ts",
    "cli:demo": "bun run games/wit-clash/terminal/demo.ts",
    "launch": "bun run launch.ts",
    "launch:dev": "bun run launch.ts dev",
    "launch:host": "bun run launch.ts host",
    "launch:prod": "bun run launch.ts prod",
    "launch:bots": "bun run launch.ts dev --bots",
    "launch:demo": "bun run launch.ts dev --demo",
    "test:coverage": "vitest run --coverage",
    "typecheck:launch": "tsc --noEmit -p tsconfig.json",
    "verify": "biome check . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p games/wit-clash/tsconfig.verify.json && vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
